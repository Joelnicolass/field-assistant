{
  "expo": {
    "name": "Field Assistant",
    "slug": "field-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "android": {
      "package": "com.fieldassistant.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A3C1E"
      }
    },
    "plugins": [
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "PlusJakartaSans",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium_Italic/PlusJakartaSans_500Medium_Italic.ttf",
                    "weight": 500,
                    "style": "italic"
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold_Italic/PlusJakartaSans_600SemiBold_Italic.ttf",
                    "weight": 600,
                    "style": "italic"
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 192,
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Field Assistant usa el micrófono para escucharte y registrar lo que pasa en el campo."
        }
      ],
      [
        "react-native-vosk",
        {
          "models": ["assets/model-es"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "extraProguardRules": "-dontwarn java.awt.**\n-keep class com.sun.jna.** { *; }\n-keepclassmembers class * extends com.sun.jna.** { public *; }\n-keep class org.vosk.** { *; }"
          }
        }
      ]
    ],
    "icon": "./assets/images/icon.png"
  }
}
