{
  "name": "field-assistant-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "research:interpret": "node --env-file=.env scripts/interpret.ts",
    "research:speak": "node --env-file=.env scripts/speak.ts",
    "eval": "node --env-file=.env eval/battery.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
